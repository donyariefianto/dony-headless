{{--  <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Canvas Form Builder – Native HTML (Relation Enhanced)
    </title>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js">
      
    </script>
    <style>
      :root {
        --bg: #f5f7fb;
        --card: #ffffff;
        --border: #e5e7eb;
        --text: #1f2937;
        --muted: #6b7280;
        --primary: #2563eb;
        --accent: #f0f6ff;
        --danger: #ef4444;
        --success: #16a34a;
      }
      
      * {
        box-sizing: border-box;
        font-family: Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,Helvetica,Arial;
      }
      
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        height: 100vh;
        display: grid;
        grid-template-columns: 240px 1fr 320px;
        grid-template-rows: 64px 1fr 56px;
        grid-template-areas: "header header header" "toolbox canvas props" "footer footer footer";
      }
      
      header {
        grid-area: header;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
        background: #0f172a;
        color: #fff;
        border-bottom: 1px solid #0b1220;
      }
      
      header h1 {
        font-size: 16px;
        margin: 0;
        font-weight: 600;
      }
      
      header .main-config {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      
      header input {
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid #172554;
        background: #0b1220;
        color: #e5edff;
      }
      .nested-form table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 14px;
      }
      .nested-form th, .nested-form td {
        border: 1px solid #ddd;
        padding: 6px 8px;
      }
      .nested-form th {
        background: #f8f9fa;
      }

      
      #toolbox {
        grid-area: toolbox;
        padding: 12px;
        border-right: 1px solid var(--border);
        background: #0b1220;
        color: #e5edff;
        overflow: auto;
      }
      
      .tool-title {
        font-size: 12px;
        text-transform: uppercase;
        opacity: .8;
        margin: 8px 0;
      }
      
      .tool-item {
        background: #111827;
        border: 1px solid #1f2937;
        color: #e5edff;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 8px;
        cursor: grab;
        user-select: none;
        text-align: center;
        font-size: 13px;
      }
      
      .tool-item:hover {
        border-color: #374151;
      }
      
      #canvasWrap {
        grid-area: canvas;
        padding: 16px;
        overflow: auto;
      }
      
      #canvas {
        min-height: 480px;
        background: var(--card);
        border: 2px dashed var(--border);
        border-radius: 14px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      
      .hint {
        color: var(--muted);
        font-size: 13px;
        text-align: center;
        margin: 24px 0;
      }
      
      .field {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
        position: relative;
      }
      
      .field-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
      }
      
      .field-badge {
        font-size: 12px;
        background: var(--accent);
        color: #1d4ed8;
        padding: 2px 8px;
        border-radius: 999px;
      }
      
      .field-title {
        font-weight: 600;
        font-size: 14px;
      }
      
      .field-children {
        margin-top: 10px;
        border: 1px dashed #cdd6f4;
        background: #fbfdff;
        border-radius: 10px;
        padding: 10px;
        min-height: 42px;
      }
      
      .selected {
        outline: 2px solid #93c5fd;
      }
      
      #props {
        grid-area: props;
        padding: 16px;
        border-left: 1px solid var(--border);
        background: var(--card);
        overflow: auto;
      }
      
      .props-section {
        margin-bottom: 16px;
      }
      
      .props-section h3 {
        font-size: 13px;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 8px;
      }
      
      .form-group {
        margin-bottom: 10px;
      }
      
      .form-group label {
        display: block;
        font-size: 13px;
        margin-bottom: 6px;
        color: #374151;
      }
      
      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 8px 10px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #fff;
      }
      
      .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      
      .btn {
        appearance: none;
        border: 1px solid var(--border);
        background: #fff;
        border-radius: 10px;
        padding: 8px 10px;
        cursor: pointer;
      }
      
      .btn.primary {
        background: var(--primary);
        color: #fff;
        border-color: transparent;
      }
      
      .btn.danger {
        background: var(--danger);
        color: #fff;
        border-color: transparent;
      }
      
      .btn.ghost {
        background: #f8fafc;
      }
      
      footer {
        grid-area: footer;
        border-top: 1px solid var(--border);
        background: var(--card);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
      }
      
      /* Preview modal */
      
      #previewModal {
        position: fixed;
        inset: 0;
        background: rgba(2,6,23,.65);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      
      .modal-card {
        background: #fff;
        max-width: 980px;
        width: 100%;
        max-height: 90vh;
        overflow: auto;
        border-radius: 14px;
        padding: 16px;
      }
      
      .preview-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 12px;
      }
      
      .preview-item[data-width="1/1"] {
        grid-column: span 2;
      }
      
      .preview-item label {
        font-size: 13px;
        margin-bottom: 6px;
        display: block;
      }
      
      .preview-item input,
      .preview-item select,
      .preview-item textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
      }
      
      /* Drag visuals */
      
      .sortable-ghost {
        opacity: .4;
      }
      
      .sortable-chosen {
        transform: scale(.98);
      }
    </style>
  </head>
  <body>
    <header>
      <h1>
        Canvas Form Builder
      </h1>
      <div class="main-config">
        <label for="mainTable">Target Table</label>
        <input id="mainTable" type="text" placeholder="e.g. users" />
        <button id="btnPreview" class="btn ghost">Preview</button>
        <button id="btnExport" class="btn primary">Export JSON</button>
      </div>
    </header>

    <!-- TOOLBOX -->
    <aside id="toolbox">
      <div class="tool-title">
        Inputs
      </div>
      <div class="tool-item" data-type="text">
        Text
      </div>
      <div class="tool-item" data-type="number">
        Number
      </div>
      <div class="tool-item" data-type="date">
        Date
      </div>
      <div class="tool-item" data-type="email">
        Email
      </div>
      <div class="tool-item" data-type="password">
        Password
      </div>
      <div class="tool-item" data-type="textarea">
        Textarea
      </div>
      <div class="tool-title">
        Choices
      </div>
      <div class="tool-item" data-type="select">
        Select
      </div>
      <div class="tool-item" data-type="radio">
        Radio
      </div>
      <div class="tool-item" data-type="checkbox">
        Checkbox
      </div>
      <div class="tool-item" data-type="switch">
        Switch
      </div>
      <div class="tool-title">
        Others
      </div>
      <div class="tool-item" data-type="file">
        File Upload
      </div>
      <div class="tool-item" data-type="relation">
        Relation
      </div>
      <div class="tool-item" data-type="group">
        Group / Section
      </div>
      <div class="tool-item" data-type="calculated">
        Calculated
      </div>
      <div class="tool-item" data-type="autofill">
        Autofill
      </div>
    </aside>

    <!-- CANVAS -->
    <section id="canvasWrap">
      <div id="canvas">
        <div class="hint">
          Drag komponen dari toolbox ke area ini. Gunakan “Group / Section” untuk membuat nested.
        </div>
      </div>
    </section>

    <!-- PROPERTIES -->
    <aside id="props">
      <div class="props-section">
        <h3>
          Field Properties
        </h3>
        <div id="propsBody">
          Pilih field di canvas untuk mengedit.
        </div>
      </div>
    </aside>

    <footer>
      <div style="display:flex;gap:8px;align-items:center">
        <button id="btnClear" class="btn danger">Clear</button>
        <button id="btnCollapse" class="btn ghost">Collapse All</button>
        <button id="btnExpand" class="btn ghost">Expand All</button>
      </div>
      <small style="color:var(--muted)">Drag & drop didukung oleh SortableJS</small>
    </footer>

    <!-- PREVIEW MODAL -->
    <div id="previewModal">
      <div class="modal-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <h3 style="margin:0">
            Preview
          </h3>
          <button id="btnClosePreview" class="btn">Close</button>
        </div>
        <div class="preview-grid" id="previewGrid">
        </div>
      </div>
    </div>

    <script>
      // ===== Utilities =====
      const uid = () => Math.random().toString(36).slice(2);
      
      const $ = (sel, ctx = document) => ctx.querySelector(sel);
      
      const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel))
      // ===== Sortable Setup =====
      ;
      
      const toolbox = document.getElementById("toolbox");
      
      const canvas = document.getElementById("canvas");
      
      let selectedEl = null;
      // Toolbox: clone only
      
      Sortable.create(toolbox, {
        group: {
          name: "form",
          pull: "clone",
          put: false
        },
        sort: false,
        animation: 150
      });
      // Canvas: accepts drops & reorders
      
      function makeCanvasSortable(container) {
        Sortable.create(container, {
          group: {
            name: "form",
            pull: true,
            put: true
          },
          animation: 150,
          handle: undefined,
          ghostClass: "sortable-ghost",
          onAdd: evt => {
            const type = evt.item.dataset.type;
            if (type) {
              const newField = buildFieldElement(createFieldData(type));
              evt.item.replaceWith(newField);
              bindField(newField);
            } else {
              bindField(evt.item);
            }
          }
        });
      }
      
      makeCanvasSortable(canvas);
      // ===== Data Model (dataset on elements) =====
      
      function createFieldData(type) {
        const base = {
          id: uid(),
          label: `${type[0].toUpperCase() + type.slice(1)} Field`,
          name: type + "_" + uid().slice(0, 5),
          type: type,
          width: "1/1",
          required: false,
          defaultValue: ""
        };
        if (type === "relation") {
          base.targetTable = "";
          base.foreignKey = "";
          base.relationType = "one-to-one";
          base.options = JSON.stringify([]); // start empty for relational select
          // new relational-specific props
          base.sourceTable = "";
          base.labelField = "";
          base.valueField = "";
          base.allowSearch = "false";
        }
        if (type === "select" || type === "radio") {
          base.options = JSON.stringify([ "Option 1", "Option 2" ]);
        }
        if (type === "group") {
          base.expanded = true;
          base.isRepeatable = false;
        }
        if (type === "calculated") {
          base.formula = "";
          base.dependencies = ""; // comma separated names
          base.readonly = true;
        }
        if (type === "autofill") {
          base.sourceField = "";
          base.autofillMode = "copy-label"; // copy-label | copy-value | map
          base.mapRules = JSON.stringify([]); // [[fromValue, toText], ...]
          base.readonly = true;
        }
        return base;
      }
      
      function buildFieldElement(data) {
        const el = document.createElement("div");
        el.className = "field";
        Object.entries(data).forEach(([ k, v ]) => el.dataset[k] = Array.isArray(v) ? JSON.stringify(v) : v);
        const header = document.createElement("div");
        header.className = "field-header";
        const title = document.createElement("div");
        title.className = "field-title";
        title.textContent = data.label;
        const badge = document.createElement("span");
        badge.className = "field-badge";
        badge.textContent = data.type;
        header.append(title, badge);
        el.appendChild(header);
        if (data.type === "group" || data.type === "relation") {
          const children = document.createElement("div");
          children.className = "field-children";
          children.textContent = "Drop fields here";
          el.appendChild(children);
          makeCanvasSortable(children);
        }
        return el;
      }
      
      function bindField(el) {
        el.onclick = e => {
          if (!el.isConnected) return;
          if (!el.classList.contains("field")) return;
        };
        el.addEventListener("click", e => {
          e.stopPropagation();
          selectField(el);
        });
      }
      // ===== Canvas interactions =====
      
      canvas.addEventListener("click", () => selectField(null));
      
      function selectField(el) {
        $$(".field", canvas).forEach(n => n.classList.remove("selected"));
        selectedEl = el;
        if (el) {
          el.classList.add("selected");
          renderProps(el);
        } else {
          $("#propsBody").innerHTML = "Pilih field di canvas untuk mengedit.";
        }
      }
      
      function optionsOfFields(predicate) {
        const names = [];
        $$(".field", canvas).forEach(el => {
          const d = el.dataset;
          if (predicate(d)) names.push({
            name: d.name,
            label: d.label,
            type: d.type
          });
        });
        return names;
      }
      
      function renderProps(el) {
        const d = el.dataset;
        const isChoice = d.type === "select" || d.type === "radio";
        const isRel = d.type === "relation";
        const isCalc = d.type === "calculated";
        const isAuto = d.type === "autofill";
        const relationFieldOptions = optionsOfFields(dd => dd.type === "relation" || dd.type === "select");
        const isGroup = d.type === "group"; 
        $("#propsBody").innerHTML = `
          <div class="props-section">
            <div class="row">
              <div class="form-group">
                <label>Label</label>
                <input id="pLabel" type="text" value="${d.label || ""}">
              </div>
              <div class="form-group">
                <label>Field Name</label>
                <input id="pName" type="text" value="${d.name || ""}">
              </div>
            </div>
            <div class="row">
              <div class="form-group">
                <label>Type</label>
                <select id="pType">
                  ${[ "text", "number", "date", "email", "password", "textarea", "select", "radio", "checkbox", "switch", "file", "relation", "group", "calculated", "autofill", "nested" ].map(t => `<option value="${t}" ${d.type === t ? "selected" : ""}>${t}</option>`).join("")}
                </select>
              </div>
              <div class="form-group">
                <label>Display Width</label>
                <select id="pWidth">
                  <option value="1/1" ${d.width === "1/1" ? "selected" : ""}>1/1 (Full)</option>
                  <option value="1/2" ${d.width === "1/2" ? "selected" : ""}>1/2 (Half)</option>
                </select>
              </div>
            </div>
            <div class="row">
              <div class="form-group">
                <label>Required</label>
                <select id="pRequired">
                  <option value="false" ${d.required !== "true" ? "selected" : ""}>No</option>
                  <option value="true" ${d.required === "true" ? "selected" : ""}>Yes</option>
                </select>
              </div>
              <div class="form-group">
                <label>Default Value</label>
                <input id="pDefault" type="text" value="${d.defaultValue || ""}">
              </div>
            </div>
          </div>
      
          ${isChoice ? `
          <div class="props-section">
            <h3>Options</h3>
            <div class="form-group">
              <label>List (pisahkan dengan koma)</label>
              <input id="pOptions" type="text" value="${JSON.parse(d.options || "[]").join(", ")}">
            </div>
          </div>` : ""}
      
          ${isRel ? `
          <div class="props-section">
            <h3>Relation</h3>
            <div class="form-group"><label>Source Table</label><input id="pSourceTable" type="text" value="${d.sourceTable || ""}"></div>
            <div class="form-group"><label>Label Field</label><input id="pLabelField" type="text" value="${d.labelField || ""}"></div>
            <div class="form-group"><label>Value Field</label><input id="pValueField" type="text" value="${d.valueField || ""}"></div>
            <div class="form-group"><label>Allow Search</label>
              <select id="pAllowSearch">
                <option value="false" ${d.allowSearch !== "true" ? "selected" : ""}>No</option>
                <option value="true" ${d.allowSearch === "true" ? "selected" : ""}>Yes</option>
              </select>
            </div>
            <div class="form-group"><label>Preview Options (opsional, koma)</label><input id="pRelOptions" type="text" value="${JSON.parse(d.options || "[]").join(", ")}"></div>
          </div>` : ""}
      
          ${isCalc ? `
          <div class="props-section">
            <h3>Calculated</h3>
            <div class="form-group"><label>Formula</label><input id="pFormula" type="text" placeholder="contoh: quantity * price" value="${d.formula || ""}"></div>
            <div class="form-group"><label>Dependencies (nama field, koma)</label><input id="pDeps" type="text" placeholder="quantity, price" value="${d.dependencies || ""}"></div>
            <small class="muted">Gunakan nama <em>Field Name</em> dari field lain sebagai variabel.</small>
          </div>` : ""}
      
          ${isAuto ? `
          <div class="props-section">
            <h3>Autofill</h3>
            <div class="form-group"><label>Source Relation/Select Field</label>
              <select id="pSourceField">
                <option value="">-- pilih --</option>
                ${relationFieldOptions.map(o => `<option value="${o.name}" ${d.sourceField === o.name ? "selected" : ""}>${o.label} (${o.name})</option>`).join("")}
              </select>
            </div>
            <div class="form-group"><label>Mode</label>
              <select id="pAutoMode">
                <option value="copy-label" ${d.autofillMode === "copy-label" ? "selected" : ""}>Copy label option</option>
                <option value="copy-value" ${d.autofillMode === "copy-value" ? "selected" : ""}>Copy value</option>
                <option value="map" ${d.autofillMode === "map" ? "selected" : ""}>Mapping rules</option>
              </select>
            </div>
            <div class="form-group"><label>Mapping Rules (satu per baris, format: nilai =&gt; hasil)</label>
              <textarea id="pMapRules" rows="4">${JSON.parse(d.mapRules || "[]").map(([ a, b ]) => `${a} => ${b}`).join("")}</textarea>
            </div>
            <small class="muted">Contoh rules: <code>VIP =&gt; Pelanggan Prioritas</code></small>
          </div>` : ""}

          ${isGroup ? `
          <div class="props-section">
            <h3>Group Settings</h3>
            <div class="form-group">
              <label>Allow add/delete rows?</label>
              <select id="pIsRepeatable">
                <option value="false" ${d.isRepeatable !== "true" ? "selected" : ""}>No</option>
                <option value="true" ${d.isRepeatable === "true" ? "selected" : ""}>Yes</option>
              </select>
            </div>
          </div>` : ""}

          <div class="row">
            <button id="pDuplicate" class="btn ghost">Duplicate</button>
            <button id="pDelete" class="btn danger">Delete</button>
          </div>
        `;
        // Bind change handlers
        $("#pLabel").oninput = e => {
          d.label = e.target.value;
          $(".field-title", el).textContent = d.label;
        };
        $("#pName").oninput = e => d.name = e.target.value;
        $("#pType").onchange = e => {
          d.type = e.target.value;
          if (d.type === "group" || d.type === "relation") {
            if (!$(".field-children", el)) {
              const c = document.createElement("div");
              c.className = "field-children";
              c.textContent = "Drop fields here";
              el.appendChild(c);
              makeCanvasSortable(c);
            }
          } else {
            const c = $(".field-children", el);
            if (c) c.remove();
          }
          $(".field-badge", el).textContent = d.type;
          renderProps(el);
        };
        $("#pWidth").onchange = e => d.width = e.target.value;
        $("#pRequired").onchange = e => d.required = e.target.value;
        $("#pDefault").oninput = e => d.defaultValue = e.target.value;
        if (isGroup) {
          $("#pIsRepeatable").onchange = e => {
            d.isRepeatable = e.target.value;
            // Panggil renderProps lagi untuk memperbarui tampilan jika ada perubahan lainnya
            renderProps(el);
          };
        }
        if (isChoice) {
          $("#pOptions").oninput = e => d.options = JSON.stringify(e.target.value.split(",").map(s => s.trim()).filter(Boolean));
        }
        if (isRel) {
          $("#pSourceTable").oninput = e => d.sourceTable = e.target.value;
          $("#pLabelField").oninput = e => d.labelField = e.target.value;
          $("#pValueField").oninput = e => d.valueField = e.target.value;
          $("#pAllowSearch").onchange = e => d.allowSearch = e.target.value;
          $("#pRelOptions").oninput = e => d.options = JSON.stringify(e.target.value.split(",").map(s => s.trim()).filter(Boolean));
        }
        if (isCalc) {
          $("#pFormula").oninput = e => d.formula = e.target.value;
          $("#pDeps").oninput = e => d.dependencies = e.target.value;
        }
        if (isAuto) {
          $("#pSourceField").onchange = e => d.sourceField = e.target.value;
          $("#pAutoMode").onchange = e => d.autofillMode = e.target.value;
          $("#pMapRules").oninput = e => {
            const lines = e.target.value.split("+").map(l => l.trim()).filter(Boolean);
            const pairs = [];
            lines.forEach(line => {
              const m = line.split("=>");
              if (m.length >= 2) {
                pairs.push([ m[0].trim(), m.slice(1).join("=>").trim() ]);
              }
            });
            d.mapRules = JSON.stringify(pairs);
          };
        }
        $("#pDelete").onclick = () => {
          el.remove();
          selectField(null);
        };
        $("#pDuplicate").onclick = () => {
          const cloneData = Object.assign({}, Object.fromEntries(Object.entries(d).map(([ k, v ]) => [ k, v ])));
          cloneData.id = uid();
          const newEl = buildFieldElement(cloneData);
          el.after(newEl);
          bindField(newEl);
        };
      }
      // ===== Add initial empty state click =====
      
      canvas.addEventListener("dragover", () => {
        $(".hint", canvas)?.remove();
      });
      // ===== Export Schema (recursive) =====
      
      function buildSchema(container) {
        const arr = [];
        $$(".field", container).forEach(el => {
          if (el.parentElement !== container) return;
          const d = el.dataset;
          const obj = {
            id: d.id,
            label: d.label || "",
            name: d.name || "",
            type: d.type,
            width: d.width || "1/1",
            required: d.required === "true",
            defaultValue: d.defaultValue || ""
          };
          if (d.type === "select" || d.type === "radio" || d.type === "relation") {
            obj.options = JSON.parse(d.options || "[]");
          }
          if (d.type === "relation") {
            obj.relation = {
              targetTable: d.targetTable || "",
              foreignKey: d.foreignKey || "",
              type: d.relationType || "one-to-one",
              sourceTable: d.sourceTable || "",
              labelField: d.labelField || "",
              valueField: d.valueField || "",
              allowSearch: d.allowSearch === "true"
            };
          }
          if (d.type === "group" || d.type === "relation") {
            const childWrap = $(".field-children", el);
            obj.children = childWrap ? buildSchema(childWrap) : [];
            if (d.type === "group") { // <-- Tambahkan blok ini
                obj.isRepeatable = d.isRepeatable === "true";
            }
          }
          if (d.type === "group" || d.type === "relation") {
            const childWrap = $(".field-children", el);
            obj.children = childWrap ? buildSchema(childWrap) : [];
          }
          if (d.type === "calculated") {
            obj.calculated = {
              formula: d.formula || "",
              dependencies: (d.dependencies || "").split(",").map(s => s.trim()).filter(Boolean)
            };
          }
          if (d.type === "autofill") {
            obj.autofill = {
              sourceField: d.sourceField || "",
              mode: d.autofillMode || "copy-label",
              mapRules: JSON.parse(d.mapRules || "[]")
            };
          }
          arr.push(obj);
        });
        return arr;
      }
      // ===== Preview =====
      
      function renderPreview() {
        const data = buildSchema(canvas);
        const grid = document.getElementById("previewGrid");
        grid.innerHTML = "";
        const inputsByName = {};
        const calculatedNodes = [];
        const autofillNodes = [];
        function renderField(f) {
          const wrap = document.createElement("div");
          wrap.className = "preview-item";
          wrap.dataset.width = f.width || "1/1";
          if (f.type !== "group" && f.type !== "nested") { // Perbaikan: abaikan label untuk group & nested
            const lbl = document.createElement("label");
            lbl.textContent = f.label || f.type;
            wrap.appendChild(lbl);
          }
          let node;
          switch (f.type) {
           case "text":
           case "email":
           case "password":
           case "date":
           case "number":
            node = document.createElement("input");
            node.type = f.type === "text" ? "text" : f.type;
            node.name = f.name;
            if (f.defaultValue) node.value = f.defaultValue;
            break;
           case "textarea":
            node = document.createElement("textarea");
            node.name = f.name;
            if (f.defaultValue) node.value = f.defaultValue;
            break;
           case "checkbox":
            node = document.createElement("input");
            node.type = "checkbox";
            node.name = f.name;
            break;
           case "radio":
            node = document.createElement("div");
            (f.options || []).forEach(opt => {
              const l = document.createElement("label");
              const r = document.createElement("input");
              r.type = "radio";
              r.name = f.name;
              r.value = opt;
              l.append(r, document.createTextNode(" " + opt));
              node.appendChild(l);
            });
            break;
           case "select":
            node = document.createElement("select");
            node.name = f.name;
            (f.options || []).forEach(opt => {
              const o = document.createElement("option");
              o.value = opt;
              o.textContent = opt;
              node.appendChild(o);
            });
            break;
           case "relation":
            node = document.createElement("select");
            node.name = f.name;
            if (f.relation && f.relation.sourceTable && f.relation.labelField && f.relation.valueField) {
              const demo = [ {
                [f.relation.valueField]: "1",
                [f.relation.labelField]: f.relation.sourceTable + " - Item A"
              }, {
                [f.relation.valueField]: "2",
                [f.relation.labelField]: f.relation.sourceTable + " - Item B"
              } ];
              demo.forEach(r => {
                const o = document.createElement("option");
                o.value = r[f.relation.valueField];
                o.textContent = r[f.relation.labelField];
                node.appendChild(o);
              });
              if (f.relation.allowSearch) {
                const hint = document.createElement("div");
                hint.style.fontSize = "12px";
                hint.style.color = "#6b7280";
                hint.textContent = "Search enabled (Choices.js integration possible)";
                wrap.appendChild(hint);
              }
            } else {
              (f.options || []).forEach(opt => {
                const o = document.createElement("option");
                o.value = opt;
                o.textContent = opt;
                node.appendChild(o);
              });
            }
            break;
           case "nested":
           case "group":
              if (f.type === "group" && f.isRepeatable !== true) {
                  // Logic for non-repeatable group (static container)
                  const box = document.createElement("div");
                  box.style.border = "1px solid var(--border)";
                  box.style.borderRadius = "10px";
                  box.style.padding = "10px";
                  box.style.background = "#fafafa";
                  const cap = document.createElement("div");
                  cap.style.fontWeight = "600";
                  cap.style.marginBottom = "6px";
                  cap.textContent = f.label || "Group";
                  box.appendChild(cap);
                  (f.children || []).forEach(ch => {
                      const childEl = renderField(ch);
                      box.appendChild(childEl);
                  });
                  wrap.appendChild(box);
                  return wrap;
              }
              // Logic for repeatable group (same as nested)
              const nestedWrapper = document.createElement("div");
              nestedWrapper.className = "nested-form";
              const nestedLabel = document.createElement("div");
              nestedLabel.style.fontWeight = "600";
              nestedLabel.style.marginBottom = "6px";
              nestedLabel.textContent = f.label || "Detail";
              nestedWrapper.appendChild(nestedLabel);

              const table = document.createElement("table");
              table.className = "nested-table";
              table.style.width = "100%";
              table.style.borderCollapse = "collapse";

              const thead = document.createElement("thead");
              const headRow = document.createElement("tr");
              (f.children || []).forEach(ch => {
                  const th = document.createElement("th");
                  th.textContent = ch.label || ch.name;
                  th.style.border = "1px solid #ccc";
                  th.style.padding = "4px";
                  headRow.appendChild(th);
              });
              const thAction = document.createElement("th");
              thAction.textContent = "Aksi";
              headRow.appendChild(thAction);
              thead.appendChild(headRow);

              const tbody = document.createElement("tbody");
              table.appendChild(thead);
              table.appendChild(tbody);
              nestedWrapper.appendChild(table);

              function addRow() {
                  const tr = document.createElement("tr");
                  (f.children || []).forEach(ch => {
                      const td = document.createElement("td");
                      td.style.border = "1px solid #ccc";
                      td.style.padding = "4px";
                      const fieldEl = renderField(ch);
                      td.appendChild(fieldEl);
                      tr.appendChild(td);
                  });
                  const tdAction = document.createElement("td");
                  tdAction.style.border = "1px solid #ccc";
                  tdAction.style.padding = "4px";
                  const btnRemove = document.createElement("button");
                  btnRemove.type = "button";
                  btnRemove.textContent = "Hapus";
                  btnRemove.onclick = () => tr.remove();
                  tdAction.appendChild(btnRemove);
                  tr.appendChild(tdAction);
                  tbody.appendChild(tr);
              }

              const addBtn = document.createElement("button");
              addBtn.type = "button";
              addBtn.textContent = "Tambah Baris";
              addBtn.style.marginTop = "6px";
              addBtn.onclick = () => addRow();
              nestedWrapper.appendChild(addBtn);

              addRow();
              return nestedWrapper;
           case "file":
            node = document.createElement("input");
            node.type = "file";
            node.name = f.name;
            break;
           case "switch":
            node = document.createElement("input");
            node.type = "checkbox";
            node.name = f.name;
            break;
           case "calculated":
            node = document.createElement("input");
            node.type = "text";
            node.name = f.name;
            node.readOnly = true;
            calculatedNodes.push({
              f: f,
              node: node
            });
            break;
           case "autofill":
            node = document.createElement("input");
            node.type = "text";
            node.name = f.name;
            node.readOnly = true;
            autofillNodes.push({
              f: f,
              node: node
            });
            break;
           default:
            node = document.createElement("input");
            node.type = "text";
            node.name = f.name;
            break;
          }
          if (node) wrap.appendChild(node);
          if (node && (node.tagName === "INPUT" || node.tagName === "TEXTAREA" || node.tagName === "SELECT")) {
            inputsByName[f.name] = node;
          }
          return wrap;
        }
        // first pass render
        data.forEach(f => grid.appendChild(renderField(f)));
        // helpers
        function computeCalculated(item) {
          const {
            f,
            node
          } = item;
          const deps = f.calculated?.dependencies || [];
          let expr = f.calculated?.formula || "";
          try {
            deps.forEach(dn => {
              const v = parseFloat(inputsByName[dn]?.value || "0");
              const safe = isFinite(v) ? v : 0;
              const re = new RegExp(`\b${dn}\b`, "g");
              expr = expr.replace(re, String(safe));
            });
            const result = Function(`"use strict"; return (${expr || 0});`)();
            node.value = (result ?? "").toString();
          } catch (e) {
            node.value = "ERR";
          }
        }
        function attachCalculated() {
          calculatedNodes.forEach(item => {
            const deps = item.f.calculated?.dependencies || [];
            deps.forEach(dn => {
              const depNode = inputsByName[dn];
              if (depNode) {
                depNode.addEventListener("input", () => computeCalculated(item));
                depNode.addEventListener("change", () => computeCalculated(item));
              }
            });
            computeCalculated(item);
          });
        }
        function valueAndLabelOfSelect(sel) {
          if (!sel) return {
            value: "",
            label: ""
          };
          const idx = sel.selectedIndex;
          const opt = sel.options[idx];
          return {
            value: sel.value || opt?.value || "",
            label: opt?.text || ""
          };
        }
        function applyAutofill(item) {
          const {
            f,
            node
          } = item;
          const src = inputsByName[f.autofill?.sourceField || ""];
          if (!src) {
            node.value = "";
            return;
          }
          const mode = f.autofill?.mode || "copy-label";
          if (src.tagName === "SELECT") {
            const {
              value,
              label
            } = valueAndLabelOfSelect(src);
            if (mode === "copy-label") node.value = label;
            else if (mode === "copy-value") node.value = value;
            else if (mode === "map") {
              const dict = Object.fromEntries(f.autofill?.mapRules || []);
              node.value = dict[value] ?? "";
            }
          } else if (src.type === "text") {
            if (mode === "copy-value" || mode === "copy-label") node.value = src.value;
          }
        }
        function attachAutofill() {
          autofillNodes.forEach(item => {
            const srcName = item.f.autofill?.sourceField || "";
            const srcNode = inputsByName[srcName];
            if (srcNode) {
              srcNode.addEventListener("input", () => applyAutofill(item));
              srcNode.addEventListener("change", () => applyAutofill(item));
            }
            applyAutofill(item);
          });
        }
        attachCalculated();
        attachAutofill();
      }
      
      function openPreview() {
        renderPreview();
        document.getElementById("previewModal").style.display = "flex";
      }
      // ===== Buttons =====
      
      $("#btnPreview").onclick = openPreview;
      
      $("#btnClosePreview").onclick = () => $("#previewModal").style.display = "none";
      
      $("#btnExport").onclick = () => {
        const out = {
          mainTargetTable: $("#mainTable").value || "",
          fields: buildSchema(canvas)
        };
        const blob = new Blob([ JSON.stringify(out, null, 2) ], {
          type: "application/json"
        });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "form-schema.json";
        a.click();
      };
      
      $("#btnClear").onclick = () => {
        canvas.innerHTML = '<div class="hint">Drag komponen dari toolbox ke area ini. Gunakan “Group / Section” untuk membuat nested.</div>';
      };
      
      $("#btnCollapse").onclick = () => {
        $$(".field-children", canvas).forEach(c => c.style.display = "none");
      };
      
      $("#btnExpand").onclick = () => {
        $$(".field-children", canvas).forEach(c => c.style.display = "block");
      }
      // Click to select existing elements (delegation)
      ;
      
      canvas.addEventListener("click", e => {
        const f = e.target.closest(".field");
        if (f) selectField(f);
      });
    </script>
  </body>
</html>  --}}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulir Responsif Mobile</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f2f5;
            padding: 20px;
        }
        form {
            background-color: #fff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            max-width: 900px;
            margin: auto;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        .form-field {
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }
        .form-field.width-1-2 {
            flex-basis: calc(50% - 10px);
        }
        .form-field.width-1-1 {
            flex-basis: 100%;
        }
        label {
            font-weight: 600;
            margin-bottom: 8px;
            color: #333;
        }
        input:not([type="radio"]):not([type="checkbox"]):not([type="file"]),
        textarea,
        select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
            transition: border-color 0.3s;
        }
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #007bff;
        }
        .group-container {
            border: 1px solid #e0e0e0;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
            background-color: #fafafa;
        }
        .group-container > h3 {
            margin-top: 0;
            font-size: 1.25em;
            color: #0056b3;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .radio-group,
        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .radio-option,
        .checkbox-option {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .switch-container {
            display: flex;
            align-items: center;
            gap: 10px;
            height: 34px;
        }
        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
        }
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: #2196F3;
        }
        input:checked + .slider:before {
            transform: translateX(26px);
        }
        input[disabled], input[readonly] {
            background-color: #e9e9e9;
            cursor: not-allowed;
            color: #555;
            border-style: dashed;
            font-style: italic;
        }
        .helper-text {
            display: block;
            margin-top: 5px;
            font-size: 0.8em;
            color: #777;
        }
        .repeatable-group-item {
            border: 1px dashed #c0c0c0;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
            position: relative;
        }
        .remove-group-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background-color: #dc3545;
            color: #fff;
            border: none;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8em;
        }
        .add-group-btn {
            background-color: #28a745;
            color: #fff;
            border: none;
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1em;
            margin-top: 10px;
        }

        /* --- Media Queries untuk tampilan mobile --- */
        @media (max-width: 768px) {
            form {
                padding: 15px;
            }
            .form-row {
                flex-direction: column;
                gap: 0;
            }
            .form-field.width-1-2 {
                flex-basis: 100%;
                margin-bottom: 15px;
            }
            .group-container {
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <form id="dynamic-form"></form>

    <script>
        const formSchema = [
            {
                "id": "q6oegaaxvp",
                "label": "Input",
                "name": "group_26ef0",
                "type": "group",
                "width": "1/2",
                "required": false,
                "defaultValue": "",
                "children": [
                    { "id": "y78j6t72lf", "label": "Text Field", "name": "text_gdqjj", "type": "text", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "3qiljsxeflj", "label": "Number Field", "name": "number_943rm", "type": "number", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "dgx9fj61c0c", "label": "Date Field", "name": "date_a395g", "type": "date", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "7v0rjcsbe7y", "label": "Email Field", "name": "email_gps7g", "type": "email", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "ogk7bqwd6qc", "label": "Password Field", "name": "password_03fcs", "type": "password", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "ywb4g69ymbm", "label": "Textarea Field", "name": "textarea_841u9", "type": "textarea", "width": "1/1", "required": false, "defaultValue": "" }
                ],
                "collection": "",
                "isRepeatable": false
            },
            {
                "id": "4krpcmtaquj",
                "label": "Grup Berulang",
                "name": "group_p8b20",
                "type": "group",
                "width": "1/1",
                "required": false,
                "defaultValue": "",
                "children": [
                    { "id": "aub1nl8w23h", "label": "Select Field", "name": "select_jfkne", "type": "select", "width": "1/1", "required": false, "defaultValue": "", "options": ["Option 1", "Option 2"] },
                    { "id": "2ypxyl5vvx8", "label": "Radio Field", "name": "radio_l39ug", "type": "radio", "width": "1/1", "required": false, "defaultValue": "", "options": ["Option A", "Option B"] },
                    { "id": "c8m7mpufg7d", "label": "Checkbox Field", "name": "checkbox_grffl", "type": "checkbox", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "sx4gmjdf94e", "label": "Switch Field", "name": "switch_3vycp", "type": "switch", "width": "1/1", "required": false, "defaultValue": "" }
                ],
                "collection": "",
                "isRepeatable": true
            },
            {
                "id": "eju6wfmn165",
                "label": "Grup Otomatis",
                "name": "group_hk3iv",
                "type": "group",
                "width": "1/1",
                "required": false,
                "defaultValue": "",
                "children": [
                    { "id": "dn70aejvco", "label": "File Field", "name": "file_077x6", "type": "file", "width": "1/1", "required": false, "defaultValue": "" },
                    { "id": "zn8r9xh8wvg", "label": "Relation Field", "name": "relation_hcdok", "type": "relation", "width": "1/1", "required": false, "defaultValue": "", "options": [], "relation": { "targetTable": "users", "foreignKey": "user_id", "type": "one-to-one", "sourceTable": "posts", "labelField": "username", "valueField": "id", "allowSearch": false } },
                    { "id": "5qqbirsaigl", "label": "Calculated Field", "name": "calculated_sgszp", "type": "calculated", "width": "1/1", "required": false, "defaultValue": "", "calculated": { "formula": "field_A + field_B", "dependencies": [] } },
                    { "id": "8s1ujxog28o", "label": "Autofill Field", "name": "autofill_uqzxr", "type": "autofill", "width": "1/1", "required": false, "defaultValue": "", "autofill": { "sourceField": "relation_hcdok", "mode": "copy-label", "mapRules": [] } }
                ],
                "collection": "",
                "isRepeatable": false
            }
        ];

        const dummyRelationData = {
            "users": [
                { "id": "user1", "username": "John Doe" },
                { "id": "user2", "username": "Jane Smith" },
                { "id": "user3", "username": "Peter Jones" }
            ]
        };

        const formContainer = document.getElementById('dynamic-form');

        function getWidthClass(widthString) {
            switch(widthString) {
                case "1/2": return "width-1-2";
                case "1/1": return "width-1-1";
                default: return "width-1-1";
            }
        }

        function renderField(field, parentElement, itemIndex = null) {
            if (field.type === 'group') {
                if (field.isRepeatable) {
                    const repeaterContainer = document.createElement('div');
                    repeaterContainer.classList.add('repeatable-group', getWidthClass(field.width));
                    
                    const groupTitle = document.createElement('h3');
                    groupTitle.textContent = field.label;
                    repeaterContainer.appendChild(groupTitle);

                    const addBtn = document.createElement('button');
                    addBtn.type = 'button';
                    addBtn.classList.add('add-group-btn');
                    addBtn.innerHTML = `+ Tambah ${field.label}`;
                    addBtn.onclick = () => {
                        const currentItemCount = repeaterContainer.querySelectorAll('.repeatable-group-item').length;
                        
                        const newGroup = document.createElement('div');
                        newGroup.classList.add('repeatable-group-item');
                        const newGroupRow = document.createElement('div');
                        newGroupRow.classList.add('form-row');
                        
                        field.children.forEach(child => renderField(child, newGroupRow, currentItemCount));
                        
                        const newRemoveBtn = document.createElement('button');
                        newRemoveBtn.type = 'button';
                        newRemoveBtn.classList.add('remove-group-btn');
                        newRemoveBtn.innerHTML = `&times; Hapus`;
                        newRemoveBtn.onclick = () => newGroup.remove();
                        
                        newGroup.appendChild(newRemoveBtn);
                        newGroup.appendChild(newGroupRow);
                        repeaterContainer.insertBefore(newGroup, addBtn);
                    };
                    
                    addBtn.click();
                    
                    parentElement.appendChild(repeaterContainer);
                    repeaterContainer.appendChild(addBtn);

                } else {
                    const groupContainer = document.createElement('div');
                    groupContainer.classList.add('group-container', getWidthClass(field.width));
                    groupContainer.innerHTML = `<h3>${field.label}</h3>`;
                    
                    const groupRow = document.createElement('div');
                    groupRow.classList.add('form-row');
                    if (field.children) {
                        field.children.forEach(child => renderField(child, groupRow));
                    }
                    groupContainer.appendChild(groupRow);
                    parentElement.appendChild(groupContainer);
                }
                return;
            }
            
            const fieldName = (itemIndex !== null) ? `${field.name}[${itemIndex}]` : field.name;

            const fieldWrapper = document.createElement('div');
            fieldWrapper.classList.add('form-field', getWidthClass(field.width));
            
            const label = document.createElement('label');
            label.textContent = field.label;
            label.htmlFor = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
            
            let inputElement;

            switch(field.type) {
                case 'text':
                case 'number':
                case 'email':
                case 'password':
                case 'date':
                case 'file':
                    inputElement = document.createElement('input');
                    inputElement.type = field.type;
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.required) inputElement.required = true;
                    if (field.defaultValue) inputElement.value = field.defaultValue;
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(inputElement);
                    break;
                case 'textarea':
                    inputElement = document.createElement('textarea');
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.required) inputElement.required = true;
                    if (field.defaultValue) inputElement.value = field.defaultValue;
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(inputElement);
                    break;
                case 'select':
                    inputElement = document.createElement('select');
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.required) inputElement.required = true;
                    
                    const defaultOption = document.createElement('option');
                    defaultOption.value = "";
                    defaultOption.textContent = `Pilih ${field.label}`;
                    defaultOption.disabled = true;
                    defaultOption.selected = true;
                    inputElement.appendChild(defaultOption);
                    
                    if (field.options) {
                        field.options.forEach(optionText => {
                            const option = document.createElement('option');
                            option.value = optionText;
                            option.textContent = optionText;
                            inputElement.appendChild(option);
                        });
                    }
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(inputElement);
                    break;
                case 'radio':
                    const radioGroup = document.createElement('div');
                    radioGroup.appendChild(label);
                    
                    if (field.options) {
                        field.options.forEach(optionText => {
                            const radioOption = document.createElement('div');
                            radioOption.classList.add('radio-option');
                            const radioInput = document.createElement('input');
                            radioInput.type = 'radio';
                            radioInput.name = fieldName;
                            radioInput.id = `${field.id}-${optionText.replace(/\s/g, '-')}` + (itemIndex !== null ? `-${itemIndex}` : '');
                            radioInput.value = optionText;
                            if (field.defaultValue === optionText) radioInput.checked = true;
                            const radioLabel = document.createElement('label');
                            radioLabel.htmlFor = radioInput.id;
                            radioLabel.textContent = optionText;
                            radioOption.appendChild(radioInput);
                            radioOption.appendChild(radioLabel);
                            radioGroup.appendChild(radioOption);
                        });
                    }
                    fieldWrapper.appendChild(radioGroup);
                    break;
                case 'checkbox':
                    const checkboxWrapper = document.createElement('div');
                    checkboxWrapper.classList.add('checkbox-option');
                    inputElement = document.createElement('input');
                    inputElement.type = 'checkbox';
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.defaultValue) inputElement.checked = true;
                    checkboxWrapper.appendChild(inputElement);
                    checkboxWrapper.appendChild(label);
                    fieldWrapper.appendChild(checkboxWrapper);
                    break;
                case 'switch':
                    const switchContainer = document.createElement('div');
                    switchContainer.classList.add('switch-container');
                    
                    const switchLabel = document.createElement('label');
                    switchLabel.classList.add('switch');
                    inputElement = document.createElement('input');
                    inputElement.type = 'checkbox';
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.defaultValue) inputElement.checked = true;
                    const slider = document.createElement('span');
                    slider.classList.add('slider');
                    switchLabel.appendChild(inputElement);
                    switchLabel.appendChild(slider);

                    switchContainer.appendChild(label);
                    switchContainer.appendChild(switchLabel);

                    fieldWrapper.appendChild(switchContainer);
                    break;
                case 'relation':
                    inputElement = document.createElement('select');
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    if (field.required) inputElement.required = true;

                    const defaultRelOption = document.createElement('option');
                    defaultRelOption.value = "";
                    defaultRelOption.textContent = `Pilih ${field.label}`;
                    defaultRelOption.disabled = true;
                    defaultRelOption.selected = true;
                    inputElement.appendChild(defaultRelOption);

                    const relatedTable = field.relation.targetTable;
                    const relatedData = dummyRelationData[relatedTable];

                    if (relatedData) {
                        const labelField = field.relation.labelField;
                        const valueField = field.relation.valueField;
                        
                        relatedData.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item[valueField];
                            option.textContent = item[labelField];
                            if (field.defaultValue && field.defaultValue === item[valueField]) {
                                option.selected = true;
                                defaultRelOption.selected = false;
                            }
                            inputElement.appendChild(option);
                        });
                    } else {
                        const noDataOption = document.createElement('option');
                        noDataOption.textContent = "Data tidak ditemukan";
                        noDataOption.disabled = true;
                        inputElement.appendChild(noDataOption);
                    }
                    
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(inputElement);
                    break;
                case 'calculated':
                case 'autofill':
                    inputElement = document.createElement('input');
                    inputElement.type = 'text';
                    inputElement.name = fieldName;
                    inputElement.id = field.id + (itemIndex !== null ? `-${itemIndex}` : '');
                    inputElement.disabled = true;
                    inputElement.readOnly = true;
                    inputElement.placeholder = `(Field ${field.label} - Nilai Otomatis)`;
                    
                    const helperText = document.createElement('small');
                    helperText.classList.add('helper-text');
                    
                    if (field.type === 'calculated') {
                        helperText.textContent = `Nilai dihitung dari formula: ${field.calculated.formula}`;
                    } else if (field.type === 'autofill') {
                        helperText.textContent = `Nilai terisi dari field: ${field.autofill.sourceField}`;
                    }
                    
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(inputElement);
                    fieldWrapper.appendChild(helperText);
                    break;
                default:
                    const unsupportedField = document.createElement('p');
                    unsupportedField.textContent = `Tipe field tidak didukung: ${field.type}`;
                    fieldWrapper.appendChild(label);
                    fieldWrapper.appendChild(unsupportedField);
                    break;
            }

            parentElement.appendChild(fieldWrapper);
        }

        const mainFormRow = document.createElement('div');
        mainFormRow.classList.add('form-row');
        formSchema.forEach(field => renderField(field, mainFormRow));
        formContainer.appendChild(mainFormRow);
    </script>
</body>
</html>